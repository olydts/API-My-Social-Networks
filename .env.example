# Copier ce fichier en .env (jamais versionné) et adapter les valeurs
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/my-social-networks
# Secret long et aléatoire, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=66ba67dfeee5fab2fba4a27689c74b8b9620fd667ab39180b0b15f7072742c0473d7304675dd1b35b68dc2f8209d9dba
JWT_EXPIRES_IN=1h
# Origines autorisées par CORS, séparées par des virgules
